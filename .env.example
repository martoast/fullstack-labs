# Webinar registration mail (server/api/webinar/register.post.ts).
# Nuxt maps NUXT_<KEY> onto runtimeConfig, so these names must stay in sync
# with the runtimeConfig block in nuxt.config.ts.
#
# Mailgun's account-level API key is disabled — SMTP is the working path.
NUXT_MAIL_HOST=smtp.mailgun.org
NUXT_MAIL_PORT=587
NUXT_MAIL_USER=no-reply@mg.example.com
NUXT_MAIL_PASSWORD=
NUXT_MAIL_FROM=no-reply@mg.example.com

# Where registration notifications land.
NUXT_WEBINAR_NOTIFY_TO=alexmartos96@gmail.com

# Optional overrides — defaults live in nuxt.config.ts. Changing these needs
# only a container restart, not a rebuild.
# NUXT_PUBLIC_WEBINAR_MEET_URL=https://meet.google.com/xxx-xxxx-xxx
# NUXT_PUBLIC_WEBINAR_GOOGLE_URL=https://calendar.app.google/xxxxxxxx
